APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# ISO 4217 currency code used for wallet display and Stripe checkout —
# single source of truth (config/app.php 'currency').
APP_CURRENCY=AED

# Comma-separated list of frontend origins allowed to call the customer
# API (config/cors.php). Add your deployed frontend's origin here — e.g.
# FRONTEND_URLS=https://app.kandurastore.com,https://admin.kandurastore.com
FRONTEND_URLS=http://localhost:5173,http://localhost:5174

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
# Local storage note: Render's filesystem is EPHEMERAL — anything written
# to storage/app/public is wiped on every deploy/restart, which is why
# design/avatar images were disappearing in production (see
# MEDIA_FIX.md). In production, set FILESYSTEM_DISK=s3 and MEDIA_DISK=s3
# below, pointed at a real S3-compatible bucket (AWS S3 or Cloudflare
# R2). Leave both as "local" for local development.
FILESYSTEM_DISK=local
MEDIA_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- S3-compatible object storage (required in production — see above) ---
# For AWS S3: leave AWS_ENDPOINT blank, AWS_USE_PATH_STYLE_ENDPOINT=false.
# For Cloudflare R2: AWS_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com,
#   AWS_USE_PATH_STYLE_ENDPOINT=true, AWS_URL=<your R2 public bucket URL>.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_URL=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
